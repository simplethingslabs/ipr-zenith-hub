# ─────────────────────────────────────────────────────────────────────────────
# API environment
#
# Copy to `api/.env` (gitignored) and fill in real values.
# Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/iprcentral"

# Signing key for admin session tokens. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# Must include the deployed frontend origin in production, e.g.
#   CORS_ORIGIN="https://iprcentral.in,https://www.iprcentral.in"
CORS_ORIGIN="http://localhost:8080,http://localhost:5173"

# ── Seed-only ────────────────────────────────────────────────────────────────
# Used exclusively by `npm run db:seed` to create/rotate the admin account.
# These were previously hard-coded in prisma/seed.ts; the password committed
# there is in git history and must be considered compromised.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
