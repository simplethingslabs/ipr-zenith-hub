# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit these.
# `api/.env` and the root `.env` were previously tracked, which is how the API's
# JWT secret and database URL ended up in the repository. Only `*.example` files
# belong in version control.
.env
.env.*
!.env.example
!.env.production.example
api/.env
api/.env.*
!api/.env.example

