# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment (Vite)
#
# Copy to `.env.local` for local development. Vite only reads env files from the
# PROJECT ROOT — a previous `src/.env.production` was silently ignored, and its
# value was also missing the `/api` path suffix, so it would have broken every
# request had it ever been picked up.
#
# Only variables prefixed `VITE_` are exposed to the browser. Never put a secret
# in this file: everything here is compiled into the public bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the admin API, including the `/api` suffix.
# Used by the admin panel, and by public pages only when live content is enabled.
# Local development: http://localhost:3001/api
VITE_API_BASE_URL=https://ipr-zenith-hub.onrender.com/api

# Whether public pages revalidate their bundled content against the live API.
#
#   false / unset  → fully static. Pages render instantly from src/content/ and
#                    make no network requests. This is the default and the right
#                    setting while the API's database is not provisioned.
#   true           → static-first, then refresh from the API in the background so
#                    edits made in the admin panel appear without a redeploy.
#
# The admin panel always talks to the API directly and ignores this flag.
VITE_ENABLE_LIVE_CONTENT=false
